{
  "name": "dsh-civ6",
  "version": "0.2.0",
  "description": "让 AI 在 DSH 会话里玩《文明6》，用的是 DSH 自己的模型，不需要另配 API Key。三个会话预设：AI 自己玩、AI 当助理（玩家自己玩）、一起玩（随时接手）；另有一个所有会话都能用的 civ6 入口工具。需要本机装好 Darianliu23/civ6-mcp（base-game-compat 分支）并在游戏里打开 Tuner。",
  "license": "MIT",
  "author": "Darian (https://github.com/Darianliu23)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Darianliu23/dsh-civ6.git"
  },
  "homepage": "https://github.com/Darianliu23/dsh-civ6#readme",
  "bugs": {
    "url": "https://github.com/Darianliu23/dsh-civ6/issues"
  },
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "civilization-vi",
    "civ6",
    "mcp"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:client": "node tools/build-client.mjs",
    "test": "node --test tests/gateway.test.mjs"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.1-rc.1 <4.0.0 || >=3.18.2 <4.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
